# ==========================================
# CareerOS Central Environment Configuration
# ==========================================

# --- 1. AI & LLM Provider API Keys ---
# Google Gemini API Key (Powers LLM reasoning, ATS analysis, and embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional fallback LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- 2. Firecrawl Web Scraping API Key ---
# Firecrawl API Key (Powers live job/hackathon web scraping for Unstop, LinkedIn, Indeed)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- 3. ArmorIQ Security Governance ---
# ArmorIQ Environment Secret & Mode
ARMORIQ_ENV=production
ARMORIQ_STRICT_MODE=true

# --- 4. PostgreSQL Database Configuration ---
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros_secret_password
POSTGRES_DB=careeros
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://careeros:careeros_secret_password@db:5432/careeros

# --- 5. Application Ports & URLs ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api
